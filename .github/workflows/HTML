<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Ledger — Deal Gallery</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap');

  :root {
    --navy: #10192E;
    --navy-deep: #0A1120;
    --cream: #F3EEE3;
    --cream-dim: #E4DCC8;
    --brass: #B08D57;
    --brass-bright: #D4AF6A;
    --ink: #1B2536;
    --line: rgba(243, 238, 227, 0.14);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--navy);
    background-image:
      radial-gradient(circle at 15% 0%, rgba(176,141,87,0.10), transparent 40%),
      radial-gradient(circle at 85% 100%, rgba(176,141,87,0.06), transparent 45%);
    color: var(--cream);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
  }

  header {
    padding: 48px 24px 32px;
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass-bright);
    margin-bottom: 14px;
  }

  h1 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .sub {
    font-size: 14px;
    color: var(--cream-dim);
    font-family: 'IBM Plex Mono', monospace;
  }

  .stats {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat-num {
    font-family: 'Fraunces', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--brass-bright);
    display: block;
    line-height: 1;
  }

  .stat-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream-dim);
    margin-top: 6px;
    display: block;
  }

  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px 100px;
  }

  #grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 22px;
  }

  .card {
    position: relative;
    background: var(--cream);
    color: var(--ink);
    border-radius: 3px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    /* Price-tag notch cut on the left edge */
    clip-path: polygon(
      14px 0%, 100% 0%, 100% 100%, 14px 100%,
      0% 50%
    );
    padding-left: 14px;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.45);
  }

  .card::before {
    content: '';
    position: absolute;
    left: 22px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--navy);
    z-index: 2;
  }

  .card-img-wrap {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #d8d0bd;
    overflow: hidden;
  }

  .card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }

  .brand {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
    opacity: 0.7;
    font-weight: 600;
  }

  .tier-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 2px;
    background: var(--navy);
    color: var(--brass-bright);
    white-space: nowrap;
  }

  .title {
    font-family: 'Fraunces', serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.28;
    margin: 2px 0 4px;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
    padding-top: 6px;
  }

  .price-now {
    font-family: 'Fraunces', serif;
    font-size: 19px;
    font-weight: 700;
    color: var(--navy);
  }

  .price-was {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #8a8370;
    text-decoration: line-through;
  }

  .discount-pill {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    background: #7A4A2E;
    padding: 2px 7px;
    border-radius: 2px;
    margin-left: auto;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    color: #6b6455;
    border-top: 1px dashed #cfc6ac;
    padding-top: 8px;
    margin-top: 4px;
  }

  #empty, #loading {
    text-align: center;
    padding: 100px 20px;
    color: var(--cream-dim);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
  }

  #empty .big {
    font-family: 'Fraunces', serif;
    font-size: 1.6rem;
    color: var(--cream);
    display: block;
    margin-bottom: 10px;
  }

  footer {
    text-align: center;
    padding: 30px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    color: rgba(243,238,227,0.35);
    border-top: 1px solid var(--line);
  }
</style>
</head>
<body>

<header>
  <div class="eyebrow">Updated Daily · Filtered To Your Size &amp; Colors</div>
  <h1>The Ledger</h1>
  <div class="sub">Every current markdown matching your filters, in one place</div>
  <div class="stats">
    <div class="stat">
      <span class="stat-num" id="stat-count">—</span>
      <span class="stat-label">Live Deals</span>
    </div>
    <div class="stat">
      <span class="stat-num" id="stat-best">—</span>
      <span class="stat-label">Best Discount</span>
    </div>
    <div class="stat">
      <span class="stat-num" id="stat-updated">—</span>
      <span class="stat-label">Last Checked</span>
    </div>
  </div>
</header>

<main>
  <div id="loading">Loading the ledger…</div>
  <div id="grid" style="display:none;"></div>
  <div id="empty" style="display:none;">
    <span class="big">Nothing on the books today.</span>
    No items currently clear your 30% threshold in your size and colors. Check back tomorrow.
  </div>
</main>

<footer>Personal deal tracker · not affiliated with any retailer listed</footer>

<script>
async function loadDeals() {
  const loadingEl = document.getElementById('loading');
  const gridEl = document.getElementById('grid');
  const emptyEl = document.getElementById('empty');

  try {
    const res = await fetch('deals.json?t=' + Date.now());
    if (!res.ok) throw new Error('no data yet');
    const data = await res.json();

    loadingEl.style.display = 'none';

    const deals = data.deals || [];
    document.getElementById('stat-count').textContent = deals.length;
    document.getElementById('stat-best').textContent = deals.length
      ? Math.round(Math.max(...deals.map(d => d.discount_percent || 0))) + '%'
      : '—';

    if (data.updated_at) {
      const d = new Date(data.updated_at);
      document.getElementById('stat-updated').textContent = d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    }

    if (!deals.length) {
      emptyEl.style.display = 'block';
      return;
    }

    gridEl.style.display = 'grid';
    gridEl.innerHTML = deals.map(renderCard).join('');
  } catch (e) {
    loadingEl.textContent = 'The ledger hasn\'t been written yet — check back after the first daily run.';
  }
}

function renderCard(d) {
  const img = d.image_url
    ? `<img src="${escapeHtml(d.image_url)}" alt="${escapeHtml(d.title)}" loading="lazy">`
    : `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8a8370;">No image</div>`;

  const sizes = (d.available_sizes || []).join(', ');
  const price = d.price != null ? '$' + d.price.toFixed(2) : '—';
  const was = d.original_price != null ? '$' + d.original_price.toFixed(2) : '';
  const pct = d.discount_percent != null ? Math.round(d.discount_percent) + '% off' : '';

  return `
    <a class="card" href="${escapeHtml(d.url)}" target="_blank" rel="noopener">
      <div class="card-img-wrap">${img}</div>
      <div class="card-body">
        <div class="card-top-row">
          <span class="brand">${escapeHtml(d.brand || d.source || '')}</span>
          ${d.tier && d.tier !== '?' ? `<span class="tier-badge">TIER ${escapeHtml(d.tier)}</span>` : ''}
        </div>
        <div class="title">${escapeHtml(d.title)}</div>
        <div class="price-row">
          <span class="price-now">${price}</span>
          ${was ? `<span class="price-was">${was}</span>` : ''}
          ${pct ? `<span class="discount-pill">${pct}</span>` : ''}
        </div>
        <div class="meta-row">
          <span>${escapeHtml(sizes || '—')}</span>
          <span>${escapeHtml(d.source || '')}</span>
        </div>
      </div>
    </a>
  `;
}

function escapeHtml(str) {
  if (str == null) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

loadDeals();
</script>

</body>
</html>
